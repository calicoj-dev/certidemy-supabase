.env
.env.local
.branches/
.temp/
node_modules/

node_modules/
scripts/.env
*.bak
patch-*.mjs
verify.json
*.tmp

# item-generation logs are build artifacts, not source
*.log

# Translation review sheets - regenerable from live data via gen-translation-review.mjs
TRANSLATION-REVIEW-*.md

# THE TRANSLATION SAMPLE IS THE EXAMINATION BANK, and that is a stronger reason than the one
# above it. TRANSLATION-REVIEW-*.md is ignored for being regenerable; this file holds 120 LIVE
# SECURE items with their keys and explanations, in three languages, drawn from all twelve
# certifications. A candidate who read it would hold a fifth of some certifications' forms.
# Regenerable in one command, and the command with its seed is printed in the document's header:
#   node --dns-result-order=ipv4first scripts/gen-translation-sample.mjs --seed=4919 --per-cert=5
TRANSLATION-SAMPLE.md

fixtures/
scripts/anchor/node_modules/

# Local MCP connector config. Machine-specific, and the shape invites a
# credential: the file is where a url with an embedded token or a headers block
# would live. Untracked all session on purpose; now enforced rather than
# remembered.
.mcp.json

# PKCE verifier + client id for the audience probe. Single-use and short-lived,
# but a credential for the ten minutes it matters.
scripts/.probe-mcp-audience.json

# Management API read of the live auth config. Carries provider settings and
# secret-shaped fields. Local reference for reconciling config.toml, never committed.
auth-config.json

# Regenerable marking spec - build artifact, read then applied, never a source.
scrum-marking-spec.json
# Purchased ISO standards - licensed per seat, copying prohibited.
# The manifest at iso-corpus-manifest.json records what the index holds.
iso-corpus/
../iso-corpus/
.verify-367-recovery.json

# THE SUPPLIED SOURCE DOCUMENTS ARE NOT COMMITTED EITHER, and this is the same decision as
# iso-corpus/ above -- it just arrived through a different door, INSIDE the repository, which
# is exactly why it needs saying. sources/incoming/ holds ITIL 4 Foundation (AXELOS, licensed),
# BS ISO/IEC 42006:2025 and BS EN ISO/IEC 17021-1:2015 (BSI, licensed per seat), the EU AI Act
# and NIST AI RMF (public), and the official ES/PT editions. A `git add -A` would have put
# three licensed standards in version control.
# What IS committed is iso-corpus-manifest.json: every file's sha256, bytes, pages and
# extracted word count, so the corpus is auditable without the bytes being in git.
sources/incoming/

# THE SOURCE LIBRARY IS NOT COMMITTED, and that is the same decision as the ISO PDFs
# living outside this repository. SOURCE-PASSAGES.json is 1.3 MB of full clause text from
# ISO/IEC 42001, 27001, 27002 and ISO 19011 -- committing it would put the licensed text in
# version control, reversing a decision this repo already made deliberately (the PDFs are
# referenced by absolute path in scripts/lib/citation-index.mjs; only the CC-licensed 2020
# Scrum Guide is tracked). It is regenerable in one command:
#   node --dns-result-order=ipv4first scripts/extract-source-passages.mjs
# The DATABASE copy is migration 375, service_role only, RLS on, anon refused.
SOURCE-PASSAGES.json

# Raw writer output is an INTERMEDIATE. The gated artifact (PILOT-GROUNDED-*.json) carries
# every item including the rejected ones, and --from reads it, so the raw file is redundant
# once gating has run. It is also more licensed quotation than needs to be in git.
PILOT-*-raw.json

# The gating CHECKPOINT is a crash-recovery file, not an artifact. It carries the same records the gated
# artifact does (plus a per-item spend and rejection delta), so committing it would be a second copy of
# every verdict -- and a second copy of the licensed key_support with them. A completed run renames it
# to `.done`; both spellings are ignored.
*.partial.jsonl
*.partial.jsonl.done

# THE GENERATED OVERRIDE FILE AND THE RE-EXTRACTION DIFF HOLD LICENSED CLAUSE TEXT, so they follow
# SOURCE-PASSAGES.json out of git. The standing rule is that licensed text stays gitignored and the
# GENERATOR lives in git -- source-overrides-42001-annex.generated.json is 37 ISO/IEC 42001 Annex A
# control statements cut from the PDF, and REEXTRACT-DIFF.md prints every changed passage BEFORE and
# AFTER, so it is two copies of each. Both regenerate in one command:
#   node --dns-result-order=ipv4first scripts/make-42001-annex-column-overrides.mjs --apply
#   node --dns-result-order=ipv4first scripts/extract-source-passages.mjs
#   node --dns-result-order=ipv4first scripts/diff-passage-reextract.mjs
# NOTE, for a decision that is not mine: source-overrides-27001.json and source-overrides-42001.json
# are TRACKED and hold four hand-reviewed statements between them. They predate this line and cannot be
# regenerated (they were copied from the PDFs with page numbers), so they are left alone and flagged
# rather than deleted.
source-overrides-*.generated.json
REEXTRACT-DIFF.md
